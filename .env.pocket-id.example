# Copy to .env next to compose.yaml (no secrets here: Pocket ID's encryption
# key, its admin API key and the dsh client secret are files under
# ${DSH_AUTH_DIR}/secrets, all created by scripts/pocket-id-setup.sh).

# Where scripts/pocket-id-setup.sh created data/ and secrets/.
DSH_AUTH_DIR=./pocket-id
# Must be a real filesystem (Unraid: /mnt/cache/appdata/..., never /mnt/user).
DSH_AUTH_DATA_DIR=./pocket-id/data
# The uid:gid that owns those directories.
DSH_AUTH_UID=1000
DSH_AUTH_GID=1000

# Pocket ID's public HTTPS address (your TLS proxy in front of port 1411).
DSH_AUTH_PUBLIC_URL=https://id.example.com
# Username of the owner account that pocket-id-bootstrap creates.
DSH_AUTH_OWNER=owner

# dsh's public HTTPS address, as your browser opens it.
DSH_OIDC_PUBLIC_URL=https://dsh.example.com
# The owner's e-mail; it is created in Pocket ID already verified.
DSH_OIDC_ALLOWED_EMAILS=owner@example.com

# How the bootstrap container resolves Pocket ID's public name (the admin API
# key is only accepted over APP_URL, and containers have no MagicDNS). With
# tsdproxy: read the address with `tailscale status | grep <proxy name>`.
POCKET_ID_HOST=id.example.com
POCKET_ID_ADDRESS=100.x.y.z
