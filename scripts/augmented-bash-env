# shellcheck shell=bash
# Per-project TMPDIR for the agent's shell, sourced via BASH_ENV before every
# dsh tool call (`bash -c`, inside the sandbox). bwrap gives each call a fresh
# /tmp and only the project is writable, so TMPDIR becomes <project>/.tmp.
# Why, and what users with their own BASH_ENV must do: README.md, "Scratch
# files and /tmp".
#
# Rules:
# - A TMPDIR that is already a writable directory is left alone.
# - Projects live under $HOME (upstream sets HOME=/workspace, the mount point).
#   Nothing happens when HOME is unset or /, outside $HOME, or at $HOME itself;
#   $HOME/.tmp is never created.
# - Walking from $HOME down to $PWD, the first directory whose .tmp can really
#   be written wins. Writability is proven by creating (mktemp, atomically),
#   then removing, a fresh probe file, because Landlock does not answer
#   access(2): `test -w` alone can say yes when the sandbox would refuse the
#   write. The probe never opens anything that already exists, so a named pipe
#   or symlink in .tmp cannot block or redirect it. A concurrent first call may
#   create .tmp first; only its existence matters.
# - Same code as upstream's /opt/deepseek-harness/bwrap-bash-env
#   (runzhliu/deepseek-harness-docker#49) except the root rule above: upstream
#   also accepts $HOME/.tmp, for sessions rooted at /workspace itself.
# - Never fail, print or leak variables: every `bash -c` sources this, also
#   under `set -euo pipefail`. Under `bash -x` its lines are not traced (the
#   guard below runs with stderr discarded) unless BASH_XTRACEFD points
#   elsewhere. Each call runs mktemp and rm for the probe; mkdir runs once per
#   project.

{ __dsh_tmp_flags=$-; set +x; } 2>/dev/null

if ! { [ -d "${TMPDIR:-}" ] && [ -w "${TMPDIR:-}" ]; }; then
  __dsh_tmp_root=${HOME:-}
  __dsh_tmp_root=${__dsh_tmp_root%/}
  case $__dsh_tmp_root in
    */./* | */../* | */. | */.. | *//*) ;;
    /?*)
      case $PWD in
        */./* | */../* | */. | */.. | *//*) ;;
        "$__dsh_tmp_root"/?*)
          __dsh_tmp_rest=${PWD#"$__dsh_tmp_root"/}
          __dsh_tmp_dir=$__dsh_tmp_root
          while [ -n "$__dsh_tmp_rest" ]; do
            __dsh_tmp_dir=$__dsh_tmp_dir/${__dsh_tmp_rest%%/*}
            case $__dsh_tmp_rest in
              */*) __dsh_tmp_rest=${__dsh_tmp_rest#*/} ;;
              *) __dsh_tmp_rest= ;;
            esac
            # mkdir may lose a race with a concurrent first call: only the
            # directory's existence matters, not which call created it.
            # The probe is a fresh file that mktemp creates atomically (O_EXCL),
            # so it never opens anything that already exists: a FIFO there
            # would block every call, a symlink would redirect the write.
            if [ -w "$__dsh_tmp_dir" ] \
              && { [ -d "$__dsh_tmp_dir/.tmp" ] || mkdir -m 0700 "$__dsh_tmp_dir/.tmp" 2>/dev/null || [ -d "$__dsh_tmp_dir/.tmp" ]; } \
              && [ -w "$__dsh_tmp_dir/.tmp" ] \
              && __dsh_tmp_probe=$(command mktemp -- "$__dsh_tmp_dir/.tmp/.dsh-probe.XXXXXXXXXX" 2>/dev/null) \
              && command rm -f -- "$__dsh_tmp_probe" 2>/dev/null; then
              export TMPDIR="$__dsh_tmp_dir/.tmp"
              break
            fi
          done
          ;;
      esac
      ;;
  esac
fi

unset __dsh_tmp_root __dsh_tmp_rest __dsh_tmp_dir __dsh_tmp_probe
case $__dsh_tmp_flags in
  *x*) unset __dsh_tmp_flags; set -x ;;
  *) unset __dsh_tmp_flags ;;
esac
