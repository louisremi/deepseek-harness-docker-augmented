# Copy to .env next to compose.yaml (no secrets here: those are files under
# ${DSH_AUTH_DIR}/secrets, created by scripts/authelia-setup.sh).

# Where scripts/authelia-setup.sh created config/, data/ and secrets/.
DSH_AUTH_DIR=./authelia
# The uid:gid that owns that directory (Authelia runs as it).
DSH_AUTH_UID=1000
DSH_AUTH_GID=1000

# Authelia's public HTTPS address (your TLS proxy in front of port 9091).
DSH_AUTH_PUBLIC_URL=https://auth.example.com
# Cookie domain for Authelia's own session: its host name (or a parent
# domain you control that is not a public suffix).
DSH_AUTH_COOKIE_DOMAIN=auth.example.com
# The username scripts/authelia-setup.sh created: the only one allowed into dsh.
DSH_AUTH_OWNER=owner

# dsh's public HTTPS address, as your browser opens it.
DSH_OIDC_PUBLIC_URL=https://dsh.example.com
# The owner's e-mail (second check, in dsh itself).
DSH_OIDC_ALLOWED_EMAILS=owner@example.com
